<%
    // Set default values if variables are not passed
    const pageTitle = typeof title !== 'undefined' ? title : 'Admin Dashboard';
    const currentPage = typeof activePage !== 'undefined' ? activePage : '';
    const currentUser = typeof user !== 'undefined' ? user : { name: 'Admin' };
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %> - CourseHub</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: #f8f9fa;
        }
        
        /* Sidebar */
        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: 250px;
            height: 100vh;
            background: #ffffff;
            border-right: 1px solid #e0e0e0;
            padding: 1.5rem 0;
            overflow-y: auto;
        }
        .logo {
            padding: 0 1.5rem;
            margin-bottom: 2rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 1.5rem;
            font-weight: 700;
            color: #000000;
        }
        .logo i {
            font-size: 2rem;
        }
        .sidebar-section {
            margin-bottom: 2rem;
        }
        .sidebar-title {
            padding: 0 1.5rem;
            font-size: 0.75rem;
            font-weight: 600;
            color: #999999;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 0.5rem;
        }
        .sidebar-menu {
            list-style: none;
            padding: 0;
        }
        .sidebar-item {
            padding: 0.75rem 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            color: #666666;
            text-decoration: none;
            transition: all 0.3s;
            cursor: pointer;
        }
        .sidebar-item:hover {
            background: #f8f9fa;
            color: #000000;
        }
        .sidebar-item.active {
            background: #f0f0ff;
            color: #000000;
            border-right: 3px solid #000000;
        }
        .sidebar-item i {
            font-size: 1.2rem;
        }
        
        /* Main Content */
        .main-content {
            margin-left: 250px;
            padding: 2rem;
        }
        
        /* Header */
        .header {
            background: #ffffff;
            padding: 1.5rem 2rem;
            margin: -2rem -2rem 2rem -2rem;
            border-bottom: 1px solid #e0e0e0;
            display: flex;
            justify-content: flex-end;
            align-items: center;
        }
        .header-actions {
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        .btn-download {
            background: #000000;
            color: #ffffff;
            border: 2px solid #000000;
            padding: 0.5rem 1.5rem;
            border-radius: 50px;
            font-weight: 600;
            transition: all 0.3s;
            text-decoration: none;
        }
        .btn-download:hover {
            background: #ffffff;
            color: #000000;
        }
        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #000000;
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
        }
        
        @media (max-width: 768px) {
            .sidebar {
                transform: translateX(-100%);
            }
            .main-content {
                margin-left: 0;
            }
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="logo">
            <i class="bi bi-mortarboard-fill"></i>
            <span>CourseHub</span>
        </div>
        
        <div class="sidebar-section">
            <div class="sidebar-title">Dashboard</div>
            <ul class="sidebar-menu">
                <li>
                    <a href="/admin/" class="sidebar-item <%= currentPage === 'dashboard' ? 'active' : '' %>">
                        <i class="bi bi-grid"></i>
                        <span>Overview</span>
                    </a>
                </li>
                <li>
                    <a href="/admin/add-course" class="sidebar-item <%= currentPage === 'add-course' ? 'active' : '' %>">
                        <i class="bi bi-plus-circle"></i>
                        <span>Add Course</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
    
    <!-- Main Content -->
    <div class="main-content">
        <!-- Header -->
        <div class="header">
            <div class="header-actions">
                <div class="user-avatar"><%= currentUser.name.charAt(0).toUpperCase() %></div>
                <a href="/auth/logout" class="btn-download">
                    <i class="bi bi-box-arrow-right me-2"></i>Logout
                </a>
            </div>
        </div>
        
        <!-- Page Content Starts Here -->
